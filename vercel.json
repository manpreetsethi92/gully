{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/r/:token", "destination": "https://gully-backend.fly.dev/r/:token" },
    { "source": "/api/:path*", "destination": "https://gully-backend.fly.dev/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
